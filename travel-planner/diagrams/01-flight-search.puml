@startuml
autonumber
title Диаграмма 1: Поиск рейса

actor Участник
box
participant "Frontend" as FE
end box
box
participant "Backend" as BE
end box
box
participant "СИРЕНА API" as Sirena
end box
box
participant "Яндекс.Авиа API" as Yandex
end box

Участник -> FE: Поиск рейсов
activate FE
FE -> BE: Запрос на поиск рейсов
activate BE

BE -> Sirena: Поиск рейсов
activate Sirena

alt #pink Нет результатов или ошибка
  Sirena --> BE: Ошибка / нет данных
  deactivate Sirena
  BE -> Yandex: Поиск рейсов (fallback)
  activate Yandex
  Yandex --> BE: Результаты поиска (с указанием провайдера)
  deactivate Yandex
else #lightgreen Успешно
  Sirena --> BE: Результаты поиска (с указанием провайдера)
  deactivate Sirena
end

BE --> FE: Список найденных рейсов (каждый с полем provider)
deactivate BE
FE --> Участник: Отображение вариантов
deactivate FE
@enduml